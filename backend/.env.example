# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Model Configuration
AI_MODEL=gpt-4o-mini-2024-07-18
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Enrichment Quality Gate Configuration
# Controls the three-layer quality validation system:
# - Layer 1: Pre-validation (fast, deterministic, $0 cost)
# - Layer 2: Judge (LLM-based quality evaluation)
# - Retry logic for failed enrichments
ENRICHMENT_MAX_RETRIES=2
ENRICHMENT_RETRY_DELAY_MS=2000
ENRICHMENT_ENABLE_PRE_VALIDATION=true
ENRICHMENT_ENABLE_JUDGE=true

# Cost Control (Rate Limiting & Budget)
# Daily OpenAI spending limit in USD (default: $10/day)
# This prevents runaway costs from abuse or bugs
OPENAI_DAILY_BUDGET=10

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Content Extraction Configuration
REQUEST_TIMEOUT_MS=10000
USER_AGENT=Mozilla/5.0 (compatible; SmartBookmarkBot/1.0)

# Logging
LOG_LEVEL=info

# LangSmith Tracing (Observability for LangChain)
# Get your API key from: https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your-langchain-api-key-here
LANGCHAIN_PROJECT=smart-bookmarks
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# Database Configuration (PostgreSQL + pgvector via Docker)
DATABASE_URL="postgresql://smartbookmarks:dev_password@localhost:5432/smartbookmarks?schema=public&connection_limit=20&pool_timeout=20"

# Redis Configuration (for caching and BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Authentication & Security
# Generate new secrets with: openssl rand -base64 32
JWT_SECRET=your-random-256-bit-secret-here
JWT_REFRESH_SECRET=your-random-256-bit-refresh-secret-here
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Admin User IDs (comma-separated UUIDs)
# Add your user UUID here after creating your first user
ADMIN_USER_IDS=

# Per-User Budget Control
OPENAI_DAILY_BUDGET_PER_USER=5.00

# Account Lockout Settings
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION=900

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# SMTP Configuration (use Mailtrap for dev, SendGrid/SES for prod)
# Mailtrap: https://mailtrap.io/
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=noreply@smartbookmarks.app

# Google OAuth Configuration
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3002/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# GitHub OAuth Configuration
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3002/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here
