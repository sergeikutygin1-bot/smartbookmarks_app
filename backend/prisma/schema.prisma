generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                          String         @id @default(uuid())
  email                       String         @unique
  passwordHash                String?        @map("password_hash")
  googleId                    String?        @unique @map("google_id")
  emailVerified               Boolean        @default(false) @map("email_verified")
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")
  githubId                    String?        @unique @map("github_id")
  resetPasswordToken          String?        @map("reset_password_token")
  resetPasswordTokenExpiresAt DateTime?      @map("reset_password_token_expires_at")
  role                        String         @default("user") @db.VarChar(20)
  verificationToken           String?        @map("verification_token")
  verificationTokenExpiresAt  DateTime?      @map("verification_token_expires_at")
  auditLogs                   AuditLog[]
  bookmarks                   Bookmark[]
  concepts                    Concept[]
  entities                    Entity[]
  refreshTokens               RefreshToken[]
  relationships               Relationship[]
  tags                        Tag[]

  @@index([verificationToken])
  @@index([resetPasswordToken])
  @@map("users")
}

model Bookmark {
  id                  String                   @id @default(uuid())
  userId              String                   @map("user_id")
  url                 String
  title               String                   @db.VarChar(500)
  domain              String                   @db.VarChar(255)
  source              String?                  @db.VarChar(255)
  summary             String?
  keyPoints           String[]                 @map("key_points")
  contentType         String                   @default("other") @map("content_type") @db.VarChar(50)
  // Status values: "pending", "completed", "needs_review", "failed"
  // - pending: Initial state, enrichment not started
  // - completed: Successfully enriched, passed all quality gates
  // - needs_review: Enrichment degraded (fallback content) or failed quality checks
  // - failed: Permanent failure after max retries
  status              String                   @default("pending") @db.VarChar(50)
  metadata            Json?
  embedding           Unsupported("vector")?
  searchVector        Unsupported("tsvector")? @map("search_vector")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  processedAt         DateTime?                @map("processed_at")
  centralityScore     Float                    @default(0.0) @map("centrality_score")
  graphPositionedAt   DateTime?                @map("graph_positioned_at")
  graphX              Float?                   @map("graph_x")
  graphY              Float?                   @map("graph_y")
  confidence          Float?
  contentMetrics      Json?                    @map("content_metrics")
  detectedContentType String?                  @map("detected_content_type") @db.VarChar(20)
  enrichmentVersion   Int                      @default(1) @map("enrichment_version")
  tags                BookmarkTag[]
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, contentType, updatedAt(sort: Desc)], map: "bookmarks_user_content_updated_idx")
  @@index([userId, status, updatedAt(sort: Desc)], map: "bookmarks_user_status_updated_idx")
  @@index([userId, centralityScore(sort: Desc)], map: "bookmarks_centrality_idx")
  @@index([userId, detectedContentType], map: "bookmarks_detected_content_type_idx")
  @@index([domain])
  @@index([status])
  @@map("bookmarks")
}

model Tag {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  name           String        @db.VarChar(100)
  normalizedName String        @map("normalized_name") @db.VarChar(100)
  color          String?       @db.VarChar(7)
  createdAt      DateTime      @default(now()) @map("created_at")
  bookmarks      BookmarkTag[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@map("tags")
}

model BookmarkTag {
  bookmarkId    String   @map("bookmark_id")
  tagId         String   @map("tag_id")
  autoGenerated Boolean  @default(false) @map("auto_generated")
  bookmark      Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  tag           Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, tagId])
  @@index([tagId])
  @@index([bookmarkId])
  @@map("bookmark_tags")
}

model Entity {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String   @db.VarChar(255)
  normalizedName  String   @map("normalized_name") @db.VarChar(255)
  entityType      String   @map("entity_type") @db.VarChar(50)
  occurrenceCount Int      @default(1) @map("occurrence_count")

  // Phase 2: Canonicalization fields
  canonicalName   String   @map("canonical_name") @db.VarChar(255)
  aliases         String[] @default([])
  wikidataId      String?  @map("wikidata_id") @db.VarChar(50)
  popularity      Int      @default(1)

  metadata        Json?
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalName, entityType], map: "entities_canonical_unique")
  @@index([userId, entityType], map: "entities_user_id_type_idx")
  @@index([userId, occurrenceCount(sort: Desc)], map: "entities_occurrence_idx")
  @@index([normalizedName])
  @@index([canonicalName], map: "entities_canonical_idx")
  @@index([popularity(sort: Desc)], map: "entities_popularity_idx")
  @@index([wikidataId], map: "entities_wikidata_idx")
  @@map("entities")
}

model Concept {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  name            String    @db.VarChar(255)
  normalizedName  String    @map("normalized_name") @db.VarChar(255)
  parentConceptId String?   @map("parent_concept_id")
  occurrenceCount Int       @default(1) @map("occurrence_count")

  // Phase 2: Canonicalization fields
  canonicalName   String    @map("canonical_name") @db.VarChar(255)
  aliases         String[]  @default([])
  description     String?   @db.Text
  popularity      Int       @default(1)

  // Phase 3 preview: Concept embeddings for semantic similarity
  embedding       Unsupported("vector(1536)")?

  createdAt       DateTime  @default(now()) @map("created_at")
  parentConcept   Concept?  @relation("ConceptHierarchy", fields: [parentConceptId], references: [id])
  childConcepts   Concept[] @relation("ConceptHierarchy")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalName], map: "concepts_canonical_unique")
  @@index([userId])
  @@index([parentConceptId], map: "concepts_parent_id_idx")
  @@index([userId, occurrenceCount(sort: Desc)], map: "concepts_occurrence_idx")
  @@index([canonicalName], map: "concepts_canonical_idx")
  @@index([popularity(sort: Desc)], map: "concepts_popularity_idx")
  @@map("concepts")
}

model Relationship {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  sourceType       String   @map("source_type") @db.VarChar(20)
  sourceId         String   @map("source_id")
  targetType       String   @map("target_type") @db.VarChar(20)
  targetId         String   @map("target_id")
  relationshipType String   @map("relationship_type") @db.VarChar(50)
  weight           Float    @default(1.0)
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId, targetType, targetId, relationshipType])
  @@index([userId, sourceType, sourceId], map: "relationships_user_source_idx")
  @@index([userId, targetType, targetId], map: "relationships_user_target_idx")
  @@index([userId, relationshipType], map: "relationships_type_idx")
  @@index([userId, relationshipType, weight(sort: Desc)], map: "relationships_weight_idx")
  @@index([userId, sourceType, sourceId, targetType, targetId], map: "relationships_source_target_idx")
  @@map("relationships")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String?
  eventType String   @map("event_type") @db.VarChar(50)
  success   Boolean
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("audit_logs")
}
